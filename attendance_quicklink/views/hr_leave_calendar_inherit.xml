<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_report_calendar_view_type_filter" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.view.type.filter</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_view"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="holiday_status_id" filters="1" invisible="1" 
                    groups="hr_holidays.group_hr_holidays_user"/>
            </field>
        </field>
    </record>

    <record id="hr_leave_report_calendar_view_search_type" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.view.search.type</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_view_search"/>
        <field name="arch" type="xml">
            <field name="job_id" position="before">
                <field name="holiday_status_id" string="Tipo de ausencia"/>
            </field>
        </field>
    </record>
</odoo>
