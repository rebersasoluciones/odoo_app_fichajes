<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="app_page" name="Fichajes: app del empleado">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'es'}"/>
            <t t-set="title">Fichaje</t>
            <t t-set="x_icon" t-value="'/attendance_quicklink/static/img/icon-192.png'"/>
            <t t-set="body_classname" t-value="'qf-body'"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#0D1015"/>
                <meta name="robots" content="noindex"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <link rel="manifest" t-att-href="'/fichaje/%s/manifest.json' % token"/>
                <link rel="apple-touch-icon" href="/attendance_quicklink/static/img/icon-192.png"/>
                <t t-call-assets="attendance_quicklink.assets_app" t-js="false"/>
                <t t-call-assets="attendance_quicklink.assets_app" t-css="false"/>
            </t>
            <div id="qf-root" t-att-data-info="app_info"/>
        </t>
    </template>

    <template id="review_page" name="Fichajes: revisar corrección">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'lang': 'es'}"/>
            <t t-set="title">Corrección de fichaje</t>
            <t t-set="x_icon" t-value="'/attendance_quicklink/static/img/icon-192.png'"/>
            <t t-set="body_classname" t-value="'qlr-body'"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex"/>
                <t t-call-assets="attendance_quicklink.assets_review" t-js="false"/>
            </t>
            <main class="qlr">
                <div class="qlr-brand">
                    <span class="qlr-dot"/>
                    <span>Fichajes</span>
                    <span class="qlr-dim" t-if="record"> · <t t-out="record.company_id.name"/></span>
                </div>
                <section class="qlr-card" t-if="not record">
                    <h1 class="qlr-title">No encontramos esta solicitud</h1>
                    <p class="qlr-text">Puede que se haya borrado o que no tengas permiso para verla con este usuario.</p>
                    <a class="qlr-link" href="/odoo">Ir a Odoo</a>
                </section>
                <section class="qlr-card" t-else="">
                    <div class="qlr-banner qlr-banner-ok" t-if="done == 'approved'">
                        Solicitud aprobada. El fichaje de <t t-out="record.employee_id.name"/> ya está corregido y el cambio queda en su historial.
                    </div>
                    <div class="qlr-banner qlr-banner-off" t-if="done == 'rejected'">
                        Solicitud rechazada. <t t-out="record.employee_id.name"/> lo verá en su app con el motivo que has indicado.
                    </div>
                    <div class="qlr-banner qlr-banner-error" t-if="error">
                        <t t-out="error"/>
                    </div>
                    <div class="qlr-eyebrow">
                        Solicitud de corrección
                        <span t-attf-class="qlr-pill qlr-pill-#{record.state}">
                            <t t-if="record.state == 'pending'">Pendiente</t>
                            <t t-elif="record.state == 'approved'">Aprobada</t>
                            <t t-else="">Rechazada</t>
                        </span>
                    </div>
                    <h1 class="qlr-title">
                        <t t-out="record.employee_id.name"/>
                        <t t-if="record.kind == 'fix'">pide corregir su fichaje del</t>
                        <t t-else="">pide añadir un tramo que olvidó fichar el</t>
                        <span t-field="record.date" t-options="{'format': 'EEEE d MMMM'}"/>
                    </h1>
                    <p class="qlr-sub">
                        <t t-out="record.employee_id.job_title or record.employee_id.job_id.name or ''"/>
                        <t t-if="record.employee_id.department_id"> · <t t-out="record.employee_id.department_id.name"/></t>
                    </p>
                    <div class="qlr-compare">
                        <div class="qlr-box">
                            <div class="qlr-box-label">Registrado</div>
                            <div class="qlr-box-value qlr-muted"><t t-out="record.original_text"/></div>
                            <div class="qlr-box-meta"><t t-out="record.original_duration_text or ''"/></div>
                        </div>
                        <div class="qlr-box qlr-box-new">
                            <div class="qlr-box-label">Solicitado</div>
                            <div class="qlr-box-value"><t t-out="record.requested_text"/></div>
                            <div class="qlr-box-meta"><t t-out="record.requested_duration_text"/> · <t t-out="record.delta_text"/></div>
                        </div>
                    </div>
                    <div class="qlr-quote">
                        <div class="qlr-box-label">Motivo</div>
                        <div class="qlr-quote-text"><t t-out="record.reason"/></div>
                    </div>
                    <div class="qlr-day">
                        <div class="qlr-box-label">Ese día</div>
                        <div class="qlr-row" t-foreach="rows" t-as="row">
                            <span class="qlr-row-main"><t t-out="row['text']"/></span>
                            <span class="qlr-row-side" t-if="row['target']">el que se corrige</span>
                        </div>
                        <div class="qlr-row" t-if="not rows">
                            <span class="qlr-row-side">Sin fichajes ese día</span>
                        </div>
                        <div class="qlr-row qlr-row-total">
                            <span class="qlr-row-side">Total del día</span>
                            <span class="qlr-row-main"><t t-out="record.day_total_text"/></span>
                        </div>
                    </div>
                    <t t-if="record.state == 'pending' and record.can_resolve">
                        <div class="qlr-actions">
                            <form method="post" t-attf-action="/fichaje/correccion/#{record.id}/aprobar" t-attf-class="qlr-action #{'qlr-action-focus' if action == 'aprobar' else ''}">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <p class="qlr-text">Al aprobar, el fichaje se modifica en Odoo y su historial guarda el valor anterior, tu usuario y la hora del cambio.</p>
                                <button type="submit" class="qlr-btn qlr-btn-ok">Aprobar la corrección</button>
                            </form>
                            <form method="post" t-attf-action="/fichaje/correccion/#{record.id}/rechazar" t-attf-class="qlr-action #{'qlr-action-focus' if action == 'rechazar' else ''}">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <label class="qlr-label" for="qlr-motivo">Motivo del rechazo</label>
                                <textarea id="qlr-motivo" name="motivo" rows="3" required="required" class="qlr-input" t-att-autofocus="'autofocus' if action == 'rechazar' else None"/>
                                <button type="submit" class="qlr-btn qlr-btn-ko">Rechazar</button>
                            </form>
                        </div>
                    </t>
                    <p class="qlr-text" t-elif="record.state == 'pending'">
                        Solo puede resolverla su responsable de asistencias o alguien con permiso sobre todas las asistencias.
                    </p>
                    <div class="qlr-resolution" t-else="">
                        <t t-if="record.state == 'approved'">Aprobada</t>
                        <t t-else="">Rechazada</t>
                        por <strong t-out="record.resolved_by_id.name"/>
                        el <span t-field="record.resolved_date"/>.
                        <div class="qlr-quote-text" t-if="record.state == 'rejected' and record.rejection_reason">
                            Motivo: <t t-out="record.rejection_reason"/>
                        </div>
                    </div>
                    <a class="qlr-link" t-attf-href="/odoo/attendance-corrections/#{record.id}">Abrir en Odoo</a>
                </section>
            </main>
        </t>
    </template>
</odoo>
