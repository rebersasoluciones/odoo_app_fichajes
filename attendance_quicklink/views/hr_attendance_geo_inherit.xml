<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_ip_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.list.ip.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="in_mode" position="before">
                <field name="in_ip_address" string="IP Entrada" optional="show"/>
                <field name="out_ip_address" string="IP Salida" optional="hidden"/>
            </field>
            <field name="in_location" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="in_latitude" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="in_longitude" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>

    <record id="view_attendance_form_ip_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.form.ip.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="in_ip_address" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="in_browser" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <xpath expr="//field[@name='in_latitude']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">not in_location and not in_latitude and not in_longitude</attribute>
            </xpath>
            <xpath expr="//label[@for='in_latitude']" position="attributes">
                <attribute name="invisible">not in_latitude and not in_longitude</attribute>
            </xpath>
            <xpath expr="//field[@name='in_latitude']/ancestor::div[2]" position="attributes">
                <attribute name="invisible">not in_latitude and not in_longitude</attribute>
            </xpath>
            <field name="out_ip_address" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="out_browser" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <xpath expr="//field[@name='out_latitude']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">not out_location and not out_latitude and not out_longitude</attribute>
            </xpath>
            <xpath expr="//label[@for='out_latitude']" position="attributes">
                <attribute name="invisible">not out_latitude and not out_longitude</attribute>
            </xpath>
            <xpath expr="//field[@name='out_latitude']/ancestor::div[2]" position="attributes">
                <attribute name="invisible">not out_latitude and not out_longitude</attribute>
            </xpath>
        </field>
    </record>
</odoo>
