<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_ip_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.list.ip.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <field name="in_mode" position="before">
                <field name="in_ip_address" string="IP Entrada" optional="show"/>
                <field name="out_ip_address" string="IP Salida" optional="hidden"/>
            </field>
        </field>
    </record>

    <record id="view_attendance_form_ip_inherit" model="ir.ui.view">
        <field name="name">hr.attendance.form.ip.inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="in_ip_address" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="in_browser" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="out_ip_address" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="out_browser" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
        </field>
    </record>
</odoo>