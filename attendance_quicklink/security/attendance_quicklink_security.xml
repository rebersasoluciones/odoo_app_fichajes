<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="attendance_correction_request_rule_company" model="ir.rule">
            <field name="name">Solicitudes de corrección: multicompañía</field>
            <field name="model_id" ref="model_attendance_correction_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="attendance_correction_request_rule_all" model="ir.rule">
            <field name="name">Solicitudes de corrección: todas</field>
            <field name="model_id" ref="model_attendance_correction_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
        </record>

        <record id="attendance_correction_request_rule_officer" model="ir.rule">
            <field name="name">Solicitudes de corrección: empleados que aprueba</field>
            <field name="model_id" ref="model_attendance_correction_request"/>
            <field name="domain_force">[('employee_id.attendance_manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        </record>
    </data>
</odoo>
