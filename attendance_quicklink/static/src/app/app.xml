<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_quicklink.App">
        <div class="qf-app" t-att-data-theme="state.theme">
            <div class="qf-center" t-if="state.invalid">
                <div class="qf-card qf-message">
                    <Icon name="'lock'" size="28"/>
                    <h1 class="qf-title">Este enlace ya no funciona</h1>
                    <p class="qf-dim">Pide a RRHH tu nuevo enlace personal de fichaje.</p>
                </div>
            </div>
            <div class="qf-center" t-elif="state.loadError">
                <div class="qf-card qf-message">
                    <Icon name="'alert'" size="28"/>
                    <h1 class="qf-title">No se ha podido cargar</h1>
                    <p class="qf-dim" t-esc="state.loadError"/>
                    <button type="button" class="qf-btn qf-btn-acc" t-on-click="() => this.retry()">Reintentar</button>
                </div>
            </div>
            <div class="qf-center" t-elif="!state.home">
                <span class="qf-spinner"/>
            </div>
            <t t-else="">
                <main class="qf-main">
                    <FicharScreen t-if="state.tab === 'fichar'"
                        api="api" home="state.home" info="props.info" theme="state.theme" nowTs="state.nowTs"
                        onHome="(home) => this.setHome(home)" onToggleTheme="() => this.toggleTheme()"
                        notify="(message, type) => this.notify(message, type)"/>
                    <CalendarioScreen t-elif="state.tab === 'calendario'"
                        api="api" today="state.home.today"
                        notify="(message, type) => this.notify(message, type)"/>
                    <SolicitudesScreen t-elif="state.tab === 'solicitudes'"
                        api="api" today="state.home.today"
                        notify="(message, type) => this.notify(message, type)"/>
                    <YoScreen t-else=""
                        api="api" home="state.home" theme="state.theme"
                        onSetTheme="(theme) => this.setTheme(theme)"
                        notify="(message, type) => this.notify(message, type)"/>
                </main>
                <nav class="qf-tabbar" aria-label="Secciones">
                    <a t-foreach="tabs" t-as="tab" t-key="tab.key" t-att-href="'#' + tab.key" class="qf-tab" t-att-class="{ 'is-on': state.tab === tab.key }" t-att-aria-current="state.tab === tab.key ? 'page' : undefined">
                        <span class="qf-tab-icon"><Icon name="tab.icon" size="21"/></span>
                        <span class="qf-tab-label" t-esc="tab.label"/>
                    </a>
                </nav>
            </t>
            <div class="qf-toasts" aria-live="polite">
                <div t-foreach="state.toasts" t-as="toast" t-key="toast.id" class="qf-toast" t-attf-class="is-{{ toast.type }}" t-esc="toast.message"/>
            </div>
        </div>
    </t>
</templates>
