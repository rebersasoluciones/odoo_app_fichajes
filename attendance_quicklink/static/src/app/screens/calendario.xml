<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_quicklink.CalendarioScreen">
        <div class="qf-screen">
            <header class="qf-topbar">
                <h1 class="qf-title">
                    <t t-esc="monthLabel"/>
                    <span class="qf-title-sub" t-esc="state.year"/>
                </h1>
                <button type="button" class="qf-iconbtn" aria-label="Mes anterior" t-on-click="() => this.shift(-1)">
                    <Icon name="'chevron-left'" size="19"/>
                </button>
                <button type="button" class="qf-iconbtn" aria-label="Mes siguiente" t-on-click="() => this.shift(1)">
                    <Icon name="'chevron-right'" size="19"/>
                </button>
            </header>

            <div class="qf-stats">
                <div class="qf-card qf-stat">
                    <div class="qf-stat-label">Trabajado</div>
                    <div class="qf-stat-value qf-num" t-esc="stats.worked"/>
                </div>
                <div class="qf-card qf-stat">
                    <div class="qf-stat-label">Ausencias</div>
                    <div class="qf-stat-value qf-sky-text" t-esc="stats.absences"/>
                </div>
                <div class="qf-card qf-stat">
                    <div class="qf-stat-label">Pendientes</div>
                    <div class="qf-stat-value qf-warn-text" t-esc="stats.pending"/>
                </div>
            </div>

            <div class="qf-cal" t-att-class="{ 'is-loading': state.loading }">
                <div class="qf-cal-dows">
                    <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                </div>
                <div class="qf-cal-grid">
                    <t t-foreach="cells" t-as="cell" t-key="cell.key">
                        <div class="qf-day-blank" t-if="cell.blank"/>
                        <button type="button" t-else="" t-att-class="cell.className" t-att-aria-label="cell.aria" t-att-aria-pressed="cell.day === state.selected ? 'true' : 'false'" t-on-click="() => this.select(cell.day)">
                            <span class="qf-day-num" t-esc="cell.day"/>
                            <span class="qf-day-label qf-num" t-esc="cell.label"/>
                        </button>
                    </t>
                </div>
                <div class="qf-legend">
                    <span><i class="qf-legend-today"/>Hoy</span>
                    <span><i class="qf-legend-worked"/>Trabajado</span>
                    <span><i class="qf-legend-leave"/>Ausencia</span>
                    <span><i class="qf-legend-pending"/>Pendiente</span>
                </div>
            </div>

            <section class="qf-card qf-list-card" t-if="selectedInfo">
                <div class="qf-card-head">
                    <span class="qf-card-title" t-esc="selectedInfo.title"/>
                    <span class="qf-dim qf-num" t-esc="selectedInfo.total"/>
                </div>
                <div class="qf-row" t-foreach="selectedInfo.leaves" t-as="leave" t-key="leave_index">
                    <span class="qf-dot qf-dot-sky"/>
                    <span class="qf-row-main" t-esc="leave.name"/>
                    <span class="qf-tag" t-att-class="leave.state === 'approved' ? 'qf-tag-ok' : 'qf-tag-warn'" t-esc="leaveStateLabel(leave)"/>
                </div>
                <div class="qf-row" t-foreach="selectedInfo.segments" t-as="segment" t-key="segment.id">
                    <span class="qf-row-main qf-num" t-esc="segment.in + ' → ' + (segment.out or (segment.open and selectedInfo.isToday ? 'ahora' : 'sin salida'))"/>
                    <span class="qf-row-side qf-num" t-esc="segment.open and selectedInfo.isToday ? 'en curso' : (segment.out ? fmtMinutes(segment.minutes) : '')"/>
                    <span class="qf-tag qf-tag-warn" t-if="segment.pending_fix">Corrección pendiente</span>
                    <button type="button" class="qf-chipbtn" t-elif="canFix(segment, selectedInfo)" t-on-click="() => this.openFix(segment)">Corregir</button>
                </div>
                <div class="qf-row qf-row-empty" t-if="!selectedInfo.segments.length and !selectedInfo.leaves.length">
                    <t t-esc="selectedInfo.isPast ? 'Sin fichajes este día.' : 'Aún no ha llegado este día.'"/>
                </div>
                <button type="button" class="qf-addbtn" t-if="selectedInfo.isPast" t-on-click="() => this.openMissing()">
                    <Icon name="'plus'" size="17"/>
                    Añadir un tramo que olvidé fichar
                </button>
            </section>

            <CorrectionSheet t-if="state.sheet" api="props.api" day="state.sheet.day" segment="state.sheet.segment" onClose="() => this.closeSheet()" onSent="() => this.onSent()"/>
        </div>
    </t>
</templates>
