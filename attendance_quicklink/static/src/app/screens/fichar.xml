<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_quicklink.FicharScreen">
        <div class="qf-screen">
            <header class="qf-topbar">
                <img class="qf-logo" t-att-src="logoUrl" alt=""/>
                <div class="qf-topbar-text">
                    <div class="qf-hello" t-esc="greeting"/>
                    <div class="qf-name" t-esc="home.employee.name"/>
                </div>
                <button type="button" class="qf-iconbtn" t-att-aria-label="isDark ? 'Pasar a tema claro' : 'Pasar a tema oscuro'" t-on-click="() => props.onToggleTheme()">
                    <Icon name="isDark ? 'sun' : 'moon'" size="19"/>
                </button>
            </header>

            <section class="qf-card qf-hero">
                <div class="qf-hero-top">
                    <span class="qf-status" t-att-class="{ 'is-in': home.checked_in }">
                        <span class="qf-status-dot"/>
                        <t t-esc="statusText"/>
                    </span>
                    <span class="qf-dim" t-esc="todayLabel"/>
                </div>
                <div class="qf-ring">
                    <svg viewBox="0 0 168 168" width="168" height="168" aria-hidden="true">
                        <circle class="qf-ring-track" cx="84" cy="84" r="71"/>
                        <circle class="qf-ring-fill" t-att-class="{ 'is-in': home.checked_in }" cx="84" cy="84" r="71" transform="rotate(-90 84 84)" t-att-style="ringStyle"/>
                    </svg>
                    <div class="qf-ring-center">
                        <div class="qf-ring-value" t-esc="workedClock"/>
                        <div class="qf-ring-label" t-esc="expectedLabel"/>
                    </div>
                </div>
                <button type="button" class="qf-punch" t-att-class="home.checked_in ? 'is-out' : 'is-in'" t-att-disabled="state.busy" t-on-click="() => this.toggle()">
                    <span class="qf-spinner qf-spinner-sm" t-if="state.busy"/>
                    <Icon t-else="" name="home.checked_in ? 'logout' : 'login'" size="21"/>
                    <t t-esc="home.checked_in ? 'Fichar salida' : 'Fichar entrada'"/>
                </button>
                <div class="qf-hint">
                    <Icon name="'pin'" size="14"/>
                    Si das permiso, se guarda la ubicación al fichar
                </div>
            </section>

            <section class="qf-card qf-list-card">
                <div class="qf-card-head">
                    <span class="qf-card-title">Hoy</span>
                    <span class="qf-dim" t-if="home.segments.length" t-esc="home.segments.length === 1 ? '1 tramo' : home.segments.length + ' tramos'"/>
                </div>
                <t t-if="home.segments.length">
                    <div class="qf-row" t-foreach="home.segments" t-as="segment" t-key="segment.id">
                        <span class="qf-dot" t-att-class="{ 'is-live': segment.open }"/>
                        <span class="qf-row-main qf-num" t-esc="segment.in + ' – ' + (segment.out or 'ahora')"/>
                        <span class="qf-row-side qf-num" t-att-class="{ 'qf-acc-text': segment.open }" t-esc="segmentDuration(segment)"/>
                    </div>
                </t>
                <div class="qf-row qf-row-empty" t-else="">Aún no hay fichajes hoy.</div>
            </section>

            <section class="qf-card">
                <div class="qf-week-head">
                    <div>
                        <div class="qf-card-title">Esta semana</div>
                        <div class="qf-dim qf-num" t-esc="weekText"/>
                    </div>
                    <div class="qf-week-balance" t-if="home.show_overtime">
                        <div class="qf-dim qf-small">Saldo de horas</div>
                        <div class="qf-balance qf-num" t-att-class="{ 'is-neg': home.overtime_minutes &lt; 0 }" t-esc="overtimeText"/>
                    </div>
                </div>
                <div class="qf-bars">
                    <div class="qf-bar-col" t-foreach="weekBars" t-as="bar" t-key="bar.date">
                        <div class="qf-bar" t-attf-class="is-{{ bar.when }}" t-att-style="'height: ' + bar.height + 'px'"/>
                        <div class="qf-bar-label" t-att-class="{ 'is-today': bar.when === 'today' }" t-esc="bar.label"/>
                    </div>
                </div>
            </section>
        </div>
    </t>
</templates>
