<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_quicklink.SolicitudesScreen">
        <div class="qf-screen">
            <header class="qf-topbar">
                <h1 class="qf-title">Solicitudes</h1>
                <button type="button" class="qf-btn qf-btn-acc qf-btn-compact" t-att-disabled="!state.data" t-on-click="() => this.state.sheet = true">
                    <Icon name="'plus'" size="18"/>
                    Nueva ausencia
                </button>
            </header>

            <div class="qf-seg" role="tablist">
                <button type="button" role="tab" class="qf-seg-btn" t-att-class="{ 'is-on': state.tab === 'leaves' }" t-att-aria-selected="state.tab === 'leaves' ? 'true' : 'false'" t-on-click="() => this.setTab('leaves')">
                    Ausencias · <t t-esc="counts.leaves"/>
                </button>
                <button type="button" role="tab" class="qf-seg-btn" t-att-class="{ 'is-on': state.tab === 'corrections' }" t-att-aria-selected="state.tab === 'corrections' ? 'true' : 'false'" t-on-click="() => this.setTab('corrections')">
                    Correcciones · <t t-esc="counts.corrections"/>
                </button>
            </div>

            <div class="qf-boot-inline" t-if="!state.data"><span class="qf-spinner"/></div>
            <t t-elif="state.tab === 'leaves'">
                <section class="qf-card" t-if="mainBalance">
                    <t t-set="bar" t-value="balanceBar(mainBalance)"/>
                    <div class="qf-balance-head">
                        <div>
                            <div class="qf-card-title" t-esc="mainBalance.name"/>
                            <div class="qf-dim qf-small">de <t t-esc="fmtNumber(mainBalance.max)"/> <t t-esc="unitLabel(mainBalance)"/></div>
                        </div>
                        <div class="qf-balance-big">
                            <span class="qf-big qf-acc-text qf-num" t-esc="fmtNumber(mainBalance.remaining)"/>
                            <span class="qf-dim qf-small">disponibles</span>
                        </div>
                    </div>
                    <div class="qf-stack">
                        <span class="qf-stack-taken" t-att-style="'flex-grow: ' + bar.taken"/>
                        <span class="qf-stack-pending" t-att-style="'flex-grow: ' + bar.pending"/>
                        <span class="qf-stack-free" t-att-style="'flex-grow: ' + bar.remaining"/>
                    </div>
                    <div class="qf-stack-legend">
                        <span><t t-esc="fmtNumber(mainBalance.taken)"/> disfrutados</span>
                        <span class="qf-warn-text" t-if="mainBalance.pending"><t t-esc="fmtNumber(mainBalance.pending)"/> pendientes</span>
                        <span t-foreach="otherBalances" t-as="other" t-key="other.id"><t t-esc="other.name"/>: <t t-esc="fmtNumber(other.remaining)"/> de <t t-esc="fmtNumber(other.max)"/></span>
                    </div>
                </section>
                <div class="qf-label">Historial</div>
                <div class="qf-items">
                    <div class="qf-item" t-foreach="leaves" t-as="leave" t-key="leave.id">
                        <span class="qf-item-icon qf-item-icon-sky"><Icon name="'leave'" size="20"/></span>
                        <div class="qf-item-text">
                            <div class="qf-item-title" t-esc="leave.type"/>
                            <div class="qf-item-sub qf-num" t-esc="leave.detail"/>
                        </div>
                        <span class="qf-tag" t-att-class="leave.tagClass" t-esc="leave.tag"/>
                    </div>
                    <div class="qf-empty" t-if="!leaves.length">Todavía no has pedido ninguna ausencia. Usa «Nueva ausencia» para empezar.</div>
                </div>
            </t>
            <t t-else="">
                <div class="qf-items">
                    <div class="qf-item" t-foreach="corrections" t-as="correction" t-key="correction.id">
                        <span class="qf-item-icon"><Icon name="'pencil'" size="20"/></span>
                        <div class="qf-item-text">
                            <div class="qf-item-title" t-esc="correction.title"/>
                            <div class="qf-item-sub qf-num" t-esc="correction.change"/>
                            <div class="qf-item-sub" t-esc="correction.note"/>
                        </div>
                        <span class="qf-tag" t-att-class="correction.tagClass" t-esc="correction.tag"/>
                    </div>
                    <div class="qf-empty" t-if="!corrections.length">No has pedido correcciones. Si un fichaje está mal, ábrelo en el Calendario y pulsa «Corregir».</div>
                </div>
            </t>

            <LeaveSheet t-if="state.sheet" api="props.api" leaveTypes="state.data.leave_types" today="props.today" onClose="() => this.state.sheet = false" onSent="(data) => this.onLeaveSent(data)"/>
        </div>
    </t>
</templates>
