<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_quicklink.CorrectionSheet">
        <Sheet title="title" subtitle="subtitle" onClose="props.onClose">
            <div class="qf-grid2">
                <label class="qf-field">
                    <span class="qf-field-label">Entrada</span>
                    <input type="time" class="qf-input qf-input-time" t-att-class="{ 'qf-input-changed': inChanged }" t-model="state.checkIn"/>
                </label>
                <label class="qf-field">
                    <span class="qf-field-label">Salida</span>
                    <input type="time" class="qf-input qf-input-time" t-att-class="{ 'qf-input-changed': outChanged }" t-model="state.checkOut"/>
                </label>
            </div>
            <div class="qf-diff" t-if="diffText">
                <Icon name="'clock'" size="15"/>
                <span t-esc="diffText"/>
            </div>
            <label class="qf-field">
                <span class="qf-field-label">Motivo</span>
                <textarea class="qf-input qf-textarea" rows="3" t-model="state.reason"/>
            </label>
            <div class="qf-note">
                <Icon name="'shield'" size="16"/>
                <span>RRHH recibe la solicitud por correo. Si la aprueba, tu fichaje se corrige y queda constancia de quién lo aprobó y cuándo.</span>
            </div>
            <div class="qf-form-error" t-if="state.error or (state.touched and validationError)" role="alert">
                <t t-esc="state.error or validationError"/>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="qf-btn qf-btn-ghost" t-on-click="() => props.onClose()">Cancelar</button>
                <button type="button" class="qf-btn qf-btn-acc" t-att-disabled="state.busy" t-on-click="() => this.submit()">
                    <span class="qf-spinner qf-spinner-sm" t-if="state.busy"/>
                    Enviar a RRHH
                </button>
            </t>
        </Sheet>
    </t>
</templates>
