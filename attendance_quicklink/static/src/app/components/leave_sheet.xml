<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_quicklink.LeaveSheet">
        <Sheet title="'Solicitar ausencia'" onClose="props.onClose">
            <t t-if="props.leaveTypes.length">
                <label class="qf-field">
                    <span class="qf-field-label">Tipo de ausencia</span>
                    <select class="qf-input qf-select" t-model="state.typeId">
                        <t t-foreach="props.leaveTypes" t-as="type" t-key="type.id">
                            <option t-att-value="type.id" t-esc="typeLabel(type)"/>
                        </t>
                    </select>
                </label>
                <t t-if="unit === 'day'">
                    <div class="qf-grid2">
                        <label class="qf-field">
                            <span class="qf-field-label">Desde</span>
                            <input type="date" class="qf-input" t-att-value="state.dateFrom" t-on-change="onDateFrom"/>
                        </label>
                        <label class="qf-field">
                            <span class="qf-field-label">Hasta</span>
                            <input type="date" class="qf-input" t-att-min="state.dateFrom" t-model="state.dateTo"/>
                        </label>
                    </div>
                </t>
                <t t-else="">
                    <label class="qf-field">
                        <span class="qf-field-label">Día</span>
                        <input type="date" class="qf-input" t-model="state.dateFrom"/>
                    </label>
                    <div class="qf-field" t-if="unit === 'half_day'">
                        <span class="qf-field-label">Parte del día</span>
                        <div class="qf-seg">
                            <button type="button" class="qf-seg-btn" t-att-class="{ 'is-on': state.period === 'am' }" t-att-aria-pressed="state.period === 'am' ? 'true' : 'false'" t-on-click="() => this.state.period = 'am'">Mañana</button>
                            <button type="button" class="qf-seg-btn" t-att-class="{ 'is-on': state.period === 'pm' }" t-att-aria-pressed="state.period === 'pm' ? 'true' : 'false'" t-on-click="() => this.state.period = 'pm'">Tarde</button>
                        </div>
                    </div>
                    <div class="qf-grid2" t-if="unit === 'hour'">
                        <label class="qf-field">
                            <span class="qf-field-label">Desde las</span>
                            <input type="time" class="qf-input qf-input-time" t-model="state.hourFrom"/>
                        </label>
                        <label class="qf-field">
                            <span class="qf-field-label">Hasta las</span>
                            <input type="time" class="qf-input qf-input-time" t-model="state.hourTo"/>
                        </label>
                    </div>
                </t>
                <div class="qf-note">
                    <Icon name="'shield'" size="16"/>
                    <span>La solicitud sigue el circuito de aprobación de ausencias de tu empresa. Verás el estado en esta pestaña.</span>
                </div>
                <div class="qf-form-error" t-if="state.error or (state.touched and validationError)" role="alert">
                    <t t-esc="state.error or validationError"/>
                </div>
            </t>
            <div class="qf-empty" t-else="">No tienes tipos de ausencia disponibles. Habla con RRHH si necesitas pedir una.</div>
            <t t-set-slot="footer">
                <button type="button" class="qf-btn qf-btn-ghost" t-on-click="() => props.onClose()">Cancelar</button>
                <button type="button" class="qf-btn qf-btn-acc" t-if="props.leaveTypes.length" t-att-disabled="state.busy" t-on-click="() => this.submit()">
                    <span class="qf-spinner qf-spinner-sm" t-if="state.busy"/>
                    Enviar solicitud
                </button>
            </t>
        </Sheet>
    </t>
</templates>
