<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="attendance_quicklink.Sheet">
        <div class="qf-sheet-layer">
            <div class="qf-scrim" t-on-click="() => props.onClose()"/>
            <div class="qf-sheet" role="dialog" aria-modal="true" t-att-aria-label="props.title" tabindex="-1" t-ref="panel">
                <div class="qf-sheet-grabber"/>
                <div class="qf-sheet-head">
                    <div class="qf-sheet-titles">
                        <div class="qf-sheet-title" t-esc="props.title"/>
                        <div class="qf-sheet-sub" t-if="props.subtitle" t-esc="props.subtitle"/>
                    </div>
                    <button type="button" class="qf-iconbtn" aria-label="Cerrar" t-on-click="() => props.onClose()">
                        <Icon name="'close'" size="18"/>
                    </button>
                </div>
                <div class="qf-sheet-body">
                    <t t-slot="default"/>
                </div>
                <div class="qf-sheet-foot" t-if="props.slots.footer">
                    <t t-slot="footer"/>
                </div>
            </div>
        </div>
    </t>
</templates>
