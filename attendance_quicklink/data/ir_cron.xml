<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_attendance_daily_report" model="ir.cron">
        <field name="name">Informe diario de fichajes</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_report()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall">2026-07-25 06:30:00</field>
    </record>
    <record id="ir_cron_quicklink_reminders" model="ir.cron">
        <field name="name">Avisos para fichar</field>
        <field name="model_id" ref="model_attendance_quicklink_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
